    },
    {
      "id": "D",
      "label": "Database"
    }
  ],
  "steps": [
    {
      "from": "A",
      "to": "B",
      "label": "Get item"
    },
    {
      "from": "B",
      "to": "C",
      "label": "Lookup"
    },
    {
      "from": "C",
      "to": "B",
      "label": "Miss",
      "return": true,
      "accent": true
    },
    {
      "frame": "On a miss",
